  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one forward action of a step: Next, Encrypt, Decrypt.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Encrypt</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 18px;border-radius:var(--radius-sm,7px);border:1px solid var(--line-strong,#c3c8d0);background:var(--card,#fff);color:var(--ink,#15181d);font:600 15px/1 var(--font,'Archivo',system-ui,sans-serif);cursor:pointer;transition:background 150ms,border-color 150ms,color 150ms}.ds-btn:focus-visible{outline:2px solid transparent;box-shadow:var(--focus,0 0 0 3px rgb(30 78 216 / .35))}.ds-btn-primary{background:var(--blue,#1e4ed8);border-color:var(--blue,#1e4ed8);color:var(--on-blue,#fff)}.ds-btn-primary:hover{background:var(--blue-hover,#1a43bb);border-color:var(--blue-hover,#1a43bb)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting actions beside the primary, often with a leading icon.",
      "html": "<button class=\"ds-btn2\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"9\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M5 15V5a2 2 0 0 1 2-2h10\"/></svg>Copy password</button>",
      "css": ".ds-btn2{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:var(--radius-sm,7px);border:1px solid var(--line-strong,#c3c8d0);background:var(--card,#fff);color:var(--ink,#15181d);font:600 15px/1 var(--font,'Archivo',system-ui,sans-serif);cursor:pointer;transition:border-color 150ms}.ds-btn2:hover{border-color:var(--ink-3,#6b727d)}.ds-btn2:focus-visible{outline:2px solid transparent;box-shadow:var(--focus,0 0 0 3px rgb(30 78 216 / .35))}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Text, password and key inputs; blue border and ring on focus, red border when invalid.",
      "html": "<label class=\"ds-label\" for=\"ds-pw\">Password</label><div class=\"ds-field\"><input id=\"ds-pw\" class=\"ds-mono\" placeholder=\"At least 12 characters\"></div>",
      "css": ".ds-label{display:block;font:600 14px/1.5 var(--font,'Archivo',system-ui,sans-serif);color:var(--ink,#15181d);margin-bottom:6px}.ds-field{display:flex;align-items:center;min-height:48px;border:1px solid var(--line-strong,#c3c8d0);border-radius:var(--radius-sm,7px);background:var(--field,#fff);transition:border-color 150ms,box-shadow 150ms}.ds-field:focus-within{border-color:var(--blue,#1e4ed8);box-shadow:var(--focus,0 0 0 3px rgb(30 78 216 / .35))}.ds-field input{flex:1;min-width:0;border:0;background:none;color:var(--ink,#15181d);padding:12px 14px;outline:none;font:15px/1.4 var(--font,'Archivo',system-ui,sans-serif)}.ds-field input.ds-mono{font-family:var(--mono,'Martian Mono',ui-monospace,monospace);font-size:13px}.ds-field input::placeholder{color:var(--ink-3,#6b727d)}"
    },
    {
      "name": "Page Nav",
      "kind": "nav",
      "refersTo": "page-nav",
      "description": "Encrypt | Decrypt toggle under the page title; a pair of links in a quiet track.",
      "html": "<nav class=\"ds-pnav\"><a href=\"#\" aria-current=\"page\">Encrypt</a><a href=\"#\">Decrypt</a></nav>",
      "css": ".ds-pnav{display:grid;grid-template-columns:1fr 1fr;padding:4px;border-radius:var(--radius,10px);background:var(--quiet,#e7e9ed);font-family:var(--font,'Archivo',system-ui,sans-serif)}.ds-pnav a{padding:10px;border-radius:var(--radius-sm,7px);text-align:center;font-weight:500;color:var(--ink-2,#545b66);text-decoration:none;transition:background 150ms,color 150ms}.ds-pnav a:hover{color:var(--ink,#15181d)}.ds-pnav a:focus-visible{outline:2px solid transparent;box-shadow:var(--focus,0 0 0 3px rgb(30 78 216 / .35))}.ds-pnav a[aria-current=page]{background:var(--seg-on,#fff);color:var(--ink,#15181d);font-weight:600;box-shadow:0 1px 2px rgb(0 0 0 / .08)}"
    },
    {
      "name": "Stepper",
      "kind": "custom",
      "refersTo": "step-marker",
      "description": "Vertical three-step spine; blue markers for current and done steps.",
      "html": "<ol class=\"ds-steps\"><li data-state=\"done\"><span class=\"ds-mk\">&#10003;</span><span class=\"ds-t\">Choose files <small>2 files</small></span></li><li data-state=\"current\"><span class=\"ds-mk\">2</span><span class=\"ds-t\">Choose a password or key</span></li><li data-state=\"todo\"><span class=\"ds-mk\">3</span><span class=\"ds-t\">Encrypt and save</span></li></ol>",
      "css": ".ds-steps{list-style:none;margin:0;padding:0;font-family:var(--font,'Archivo',system-ui,sans-serif)}.ds-steps li{position:relative;display:grid;grid-template-columns:28px 1fr;column-gap:14px;padding-bottom:22px}.ds-steps li:last-child{padding-bottom:0}.ds-steps li:not(:last-child)::before{content:'';position:absolute;left:13.5px;top:32px;bottom:4px;width:1px;background:var(--line-strong,#c3c8d0)}.ds-mk{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font:600 13px/1 inherit;background:var(--quiet,#e7e9ed);color:var(--ink-2,#545b66)}[data-state=current] .ds-mk,[data-state=done] .ds-mk{background:var(--blue,#1e4ed8);color:var(--on-blue,#fff)}.ds-t{padding-top:3px;font-size:16px;font-weight:600;line-height:1.4;color:var(--ink,#15181d)}.ds-t small{margin-left:8px;font-size:14px;font-weight:400;color:var(--ink-2,#545b66)}[data-state=todo] .ds-t{color:var(--ink-3,#6b727d);font-weight:500}"
    },
    {
      "name": "Seal Row",
      "kind": "custom",
      "refersTo": "seal-strip",
