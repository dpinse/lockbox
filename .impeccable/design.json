      "html": "<div class=\"ds-seal-row\"><div class=\"ds-seal\"><span class=\"ds-kind\">SEAL N&ordm;</span><span class=\"ds-num\">105E&middot;D98F</span></div><div class=\"ds-info\"><span>tax-return-2025.pdf.lockbox</span><small>Saved to your downloads</small></div><span class=\"ds-status\">Sealed</span></div><div class=\"ds-seal-row ds-torn\"><div class=\"ds-seal\"><span class=\"ds-kind\">BROKEN</span><span class=\"ds-num\">BDBD&middot;A080</span></div><div class=\"ds-info\"><span>passport-scan.jpg.lockbox</span><small>This file was changed after it was sealed.</small></div><span class=\"ds-status\">Seal broken</span></div>",
      "css": ".ds-seal-row{display:grid;grid-template-columns:156px 1fr auto;align-items:center;min-height:60px;margin-bottom:8px;border:1px solid var(--line,#e1e4e8);border-radius:var(--radius-sm,7px);background:var(--card,#fff);overflow:hidden;font-family:var(--font,'Archivo',system-ui,sans-serif);color:var(--ink,#15181d)}.ds-seal{align-self:stretch;display:flex;flex-direction:column;justify-content:center;padding:0 14px;background:var(--seal,#1e4ed8);color:var(--on-blue,#fff);border-right:2px dashed rgb(255 255 255 / .7);animation:ds-lay 520ms cubic-bezier(.16,1,.3,1) both}.ds-kind{font:600 10px/1.2 inherit;letter-spacing:.12em;opacity:.85}.ds-num{font:600 13px/1.4 var(--mono,'Martian Mono',ui-monospace,monospace);font-variant-numeric:tabular-nums}.ds-info{display:flex;flex-direction:column;min-width:0;padding:10px 16px;font-weight:500}.ds-info small{font-size:14px;font-weight:400;color:var(--ink-2,#545b66)}.ds-status{padding-right:16px;font-size:14px;font-weight:600;color:var(--blue-text,#1e4ed8)}.ds-torn .ds-seal{background:var(--red,#b4231a);color:var(--card,#fff);border-right-color:transparent;animation:none}.ds-torn .ds-status,.ds-torn .ds-info small{color:var(--red,#b4231a)}@keyframes ds-lay{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}@media (prefers-reduced-motion:reduce){.ds-seal{animation:none}}"
