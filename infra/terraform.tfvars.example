# Copy to terraform.tfvars (git-ignored) and fill in.
budget_email = "you@example.com"

# Shared AWS account? The budget only counts resources tagged Project=lockbox, but AWS applies that filter
# only after you activate "Project" in Billing -> Cost allocation tags (it can take up to 24h to appear).
# Or skip the budget entirely and rely on your account's existing alerts:
# create_budget = false

# Already deploying other repos from GitHub Actions? Your account likely has GitHub's OIDC provider:
# create_github_oidc_provider = false
